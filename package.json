{
  "name": "dsh-plugin-tools-panel",
  "version": "0.3.1",
  "type": "module",
  "description": "One composer panel with four tabs: a per-tool live kill switch, per-skill model visibility, per-section system-prompt injection switches, and a plugin on/off switch for the whole profile. · 输入框工具条上的一个面板，四个 tab：逐个工具的实时开关、技能的模型可见性、系统提示词段落的注入开关，以及整个 profile 的插件启停。",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "tool",
    "guard",
    "kill-switch",
    "deny",
    "group",
    "分组",
    "plugin",
    "switch",
    "toggle",
    "composer",
    "skill",
    "prompt",
    "system-prompt"
  ],
  "main": "src/index.js",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./agent": "./src/agent.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
